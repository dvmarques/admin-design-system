# Texto sempre em LF, no repositório e no checkout, inclusive no Windows com
# core.autocrlf=true: o Prettier (endOfLine padrão "lf") e os demais checks
# comparam conteúdo com LF.
* text=auto eol=lf

# Binários (baselines PNG do E2E): sem conversão de fim de linha nem diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
