{
	"name": "@admin-ds/highlighted-code",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"sideEffects": [
		"./dist/styles.css"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"types": "./dist/index.d.ts",
	"peerDependencies": {
		"react": ">=18.2.0",
		"react-dom": ">=18.2.0"
	},
	"dependencies": {
		"@shikijs/langs": "4.5.0",
		"@shikijs/themes": "4.5.0",
		"shiki": "4.5.0"
	},
	"scripts": {
		"build:css": "node ./scripts/build-css.mjs",
		"verify:package": "node ./scripts/verify-package.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "node --test ./tests/**/*.test.mjs && vitest run --root ../.. --config vitest.config.ts packages/highlighted-code",
		"test:quiet": "node --test --test-reporter=dot ./tests/**/*.test.mjs && vitest run --root ../.. --config vitest.config.ts --silent=passed-only packages/highlighted-code",
		"test:node": "node --test ./tests/**/*.test.mjs",
		"test:node:quiet": "node --test --test-reporter=dot ./tests/**/*.test.mjs",
		"build": "tsc -p tsconfig.build.json && npm run build:css && npm run verify:package"
	}
}
