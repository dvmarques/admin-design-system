{
	"name": "@admin-ds/tokens",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"sideEffects": [
		"./dist/tokens.css"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/tokens.css"
	},
	"types": "./dist/index.d.ts",
	"scripts": {
		"generate": "node ./scripts/generate-tokens.mjs",
		"check:generated": "node ./scripts/check-generated.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"build": "npm run generate && tsc -p tsconfig.build.json",
		"test": "npm run test:node",
		"test:quiet": "npm run test:node:quiet",
		"test:node": "node --test ./tests/**/*.test.mjs",
		"test:node:quiet": "node --test --test-reporter=dot ./tests/**/*.test.mjs"
	}
}
