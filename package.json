{
	"name": "admin-design-system",
	"version": "0.1.0",
	"private": true,
	"packageManager": "npm@11.19.1",
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=11.0.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"prepare": "husky",
		"format": "prettier --check .",
		"format:write": "prettier --write .",
		"lint": "eslint .",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test": "npm run test:node && npm run test:unit",
		"test:verbose": "npm run test:node && npm run test:unit",
		"test:quiet": "npm run test:node:quiet && npm run test:unit:quiet",
		"test:node": "npm run test:node --workspaces --if-present",
		"test:node:quiet": "npm --silent run test:node:quiet --workspaces --if-present",
		"test:unit": "npm run build:css --workspace @admin-ds/components && vitest run",
		"test:unit:quiet": "npm run build:css --workspace @admin-ds/components && vitest run --silent=passed-only",
		"test:release": "node --test ./scripts/*release*.test.mjs",
		"test:ci": "node --test ./scripts/ci-changed-paths.test.mjs",
		"test:quality": "npm run generate --workspace @admin-ds/tokens && npm run test:quiet && npm run test:release && npm run test:ci && npm run check:agent-skills && npm run check:generated --workspace @admin-ds/tokens",
		"sync:agent-skills": "node ./scripts/sync-agent-skills.mjs",
		"check:agent-skills": "node ./scripts/sync-agent-skills.mjs --check",
		"inspect:packages": "node ./scripts/inspect-packages.mjs",
		"build": "node ./scripts/build-all.mjs",
		"test:e2e": "playwright test --reporter=dot",
		"test:e2e:verbose": "playwright test --reporter=list",
		"release:prepare": "node ./scripts/prepare-release.mjs",
		"release:validate": "node ./scripts/validate-release.mjs",
		"release:notes": "node ./scripts/extract-release-notes.mjs",
		"validate": "npm run format && npm run lint && npm run build && npm run typecheck && npm run test:quality && npm run test:e2e"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,css,yml,yaml}": "prettier --write"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.0",
		"@storybook/react-vite": "^10.5.5",
		"@tailwindcss/cli": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.19.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"axe-core": "^4.12.1",
		"eslint": "^10.8.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"lint-staged": "^16.4.0",
		"next": "^16.2.12",
		"prettier": "^3.9.6",
		"storybook": "^10.5.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"allowScripts": {
		"@parcel/watcher@2.5.1": true,
		"esbuild@0.28.1": true
	}
}
