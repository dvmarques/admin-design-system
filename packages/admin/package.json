{
	"name": "@admin-ds/admin",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"sideEffects": [
		"./dist/styles.css"
	],
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"types": "./dist/index.d.ts",
	"peerDependencies": {
		"@admin-ds/components": "0.0.1",
		"react": ">=18.2.0",
		"react-dom": ">=18.2.0"
	},
	"devDependencies": {
		"@admin-ds/components": "0.0.1"
	},
	"scripts": {
		"build:css": "node ./scripts/build-css.mjs",
		"verify:package": "node ./scripts/verify-package.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "node --test ./tests/**/*.test.mjs && vitest run --root ../.. --config vitest.config.ts packages/admin",
		"test:quiet": "node --test --test-reporter=dot ./tests/**/*.test.mjs && vitest run --root ../.. --config vitest.config.ts --silent=passed-only packages/admin",
		"build": "tsc -p tsconfig.build.json && npm run build:css && npm run verify:package",
		"test:node": "node --test ./tests/**/*.test.mjs",
		"test:node:quiet": "node --test --test-reporter=dot ./tests/**/*.test.mjs"
	}
}
