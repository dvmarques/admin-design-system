{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [{ "type": "command", "command": "node .claude/hooks/guard-generated.mjs" }]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [{ "type": "command", "command": "node .claude/hooks/format-edited.mjs" }]
			}
		]
	}
}
