{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "^apply_patch$",
				"hooks": [
					{
						"type": "command",
						"command": "node -e \"const c=require('node:child_process');const p=require('node:path');const root=c.execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const r=c.spawnSync(process.execPath,[p.join(root,'.codex/hooks/guard-generated.mjs')],{stdio:'inherit'});if(r.error)console.error(r.error.message);process.exit(r.status??1)\"",
						"timeout": 10,
						"statusMessage": "Verificando arquivos gerados"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^apply_patch$",
				"hooks": [
					{
						"type": "command",
						"command": "node -e \"const c=require('node:child_process');const p=require('node:path');const root=c.execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const r=c.spawnSync(process.execPath,[p.join(root,'.codex/hooks/format-edited.mjs')],{stdio:'inherit'});if(r.error)console.error(r.error.message);process.exit(r.status??1)\"",
						"timeout": 30,
						"statusMessage": "Formatando arquivos editados"
					}
				]
			}
		]
	}
}
