{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"baseUrl": ".",
		"paths": {
			"@admin-ds/tokens": ["packages/tokens/src/index.ts"],
			"@admin-ds/components": ["packages/components/src/index.ts"],
			"@admin-ds/admin": ["packages/admin/src/index.ts"]
		},
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true
	}
}
