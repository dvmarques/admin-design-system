{
	"name": "admin-design-system",
	"version": "0.0.0",
	"private": true,
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=11.0.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"format": "prettier --check .",
		"format:write": "prettier --write .",
		"lint": "eslint .",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"build": "npm run build --workspaces --if-present",
		"validate": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.0",
		"@storybook/react-vite": "^10.5.5",
		"@tailwindcss/cli": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"axe-core": "^4.12.1",
		"eslint": "^10.8.0",
		"jsdom": "^29.1.1",
		"next": "^16.2.12",
		"prettier": "^3.9.6",
		"storybook": "^10.5.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	}
}
