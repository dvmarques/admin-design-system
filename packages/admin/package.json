{
	"name": "@dvmarques/admin-ds-admin",
	"version": "0.1.0",
	"private": false,
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"./dist/styles.css"
	],
	"files": [
		"dist",
		"LICENSE.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"types": "./dist/index.d.ts",
	"peerDependencies": {
		"@dvmarques/admin-ds-components": "0.1.0",
		"react": ">=18.2.0",
		"react-dom": ">=18.2.0"
	},
	"devDependencies": {
		"@dvmarques/admin-ds-components": "0.1.0"
	},
	"scripts": {
		"build:css": "node ./scripts/build-css.mjs",
		"verify:package": "node ./scripts/verify-package.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "node --test ./tests/**/*.test.mjs && vitest run --root ../.. --config vitest.config.ts packages/admin",
		"test:quiet": "node --test --test-reporter=dot ./tests/**/*.test.mjs && vitest run --root ../.. --config vitest.config.ts --silent=passed-only packages/admin",
		"build": "tsc -p tsconfig.build.json && npm run build:css && npm run verify:package",
		"test:node": "node --test ./tests/**/*.test.mjs",
		"test:node:quiet": "node --test --test-reporter=dot ./tests/**/*.test.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "Daniel Marques",
	"description": "Composições administrativas do Admin Design System",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dvmarques/admin-design-system.git",
		"directory": "packages/admin"
	}
}
