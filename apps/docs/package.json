{
	"name": "@admin-ds/docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"dependencies": {
		"@admin-ds/components": "workspace:*",
		"@admin-ds/tokens": "workspace:*",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"scripts": {
		"dev": "storybook dev -p 6006",
